{
  "manifest_version": 3,
  "name": "rinka",
  "version": "0.4.1",
  "description": "Vibe MCP橋。ツールバーアイコンでOFF/ON/WRITEを循環切替。ONの間はFirefoxの読み取りツール（タブ一覧・本文・select選択肢列挙・要素列挙・表構造・条件待ち・スクリーンショット・履歴検索）、WRITE（バッジW・自動落ちあり）の間は書込みツール（タブ操作・ナビゲーション・クリック・フォーム入力・スクロール）をVibe Workに貸す。",
  "browser_specific_settings": {
    "gecko": {
      "id": "{05d1c7e7-a96a-4750-9202-388d104b2ab6}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    }
  },
  "background": {
    "scripts": ["guards.js", "background.js"]
  },
  "action": {
    "default_title": "rinka: クリックでON/OFF切替"
  },
  "permissions": ["tabs", "scripting", "history", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "incognito": "not_allowed",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
