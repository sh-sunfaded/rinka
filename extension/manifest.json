{
  "manifest_version": 3,
  "name": "rinka",
  "version": "0.1.0",
  "description": "Vibe MCP橋。ツールバーアイコンでON/OFF。ONの間だけFirefoxの読み取りツール（タブ一覧・本文・スクリーンショット・履歴検索）をVibe Workに貸す。",
  "browser_specific_settings": {
    "gecko": {
      "id": "rinka@example.invalid",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "rinka: クリックでON/OFF切替"
  },
  "permissions": ["tabs", "scripting", "history", "nativeMessaging"],
  "incognito": "not_allowed",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
